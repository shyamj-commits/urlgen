"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Starlink — URL Generator</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\" />\n<style>\n  :root {\n    --void:      #05060f;\n    --deep:      #0a0b1e;\n    --panel:     rgba(20, 22, 48, 0.55);\n    --panel-brd: rgba(140, 150, 255, 0.14);\n    --star:      #eef1ff;\n    --ink:       #e8eaff;\n    --ink-soft:  #9aa0d0;\n    --ink-faint: #5c6199;\n    --accent:    #8b8dff;\n    --accent-2:  #52e5ff;\n    --nebula-a:  #6d3bff;\n    --nebula-b:  #ff4fa3;\n    --nebula-c:  #1f7bff;\n    --good:      #4fffc4;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  html, body { height: 100%; }\n\n  body {\n    font-family: 'Sora', sans-serif;\n    background: var(--void);\n    color: var(--ink);\n    min-height: 100%;\n    overflow-x: hidden;\n    position: relative;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  /* ---------- Cosmic backdrop ---------- */\n  #space {\n    position: fixed;\n    inset: 0;\n    z-index: 0;\n    background:\n      radial-gradient(1200px 800px at 15% -10%, rgba(109,59,255,0.28), transparent 60%),\n      radial-gradient(1000px 700px at 100% 10%, rgba(31,123,255,0.22), transparent 55%),\n      radial-gradient(900px 900px at 60% 120%, rgba(255,79,163,0.16), transparent 55%),\n      linear-gradient(180deg, #05060f 0%, #080a1c 45%, #05060f 100%);\n  }\n  #stars { position: fixed; inset: 0; z-index: 1; display: block; }\n\n  /* soft floating nebula wisp */\n  .wisp {\n    position: fixed;\n    border-radius: 50%;\n    filter: blur(80px);\n    opacity: 0.5;\n    z-index: 1;\n    pointer-events: none;\n    mix-blend-mode: screen;\n    animation: drift 26s ease-in-out infinite;\n  }\n  .wisp.a { width: 42vw; height: 42vw; left: -8vw;  top: -6vw;  background: radial-gradient(circle, var(--nebula-a), transparent 70%); }\n  .wisp.b { width: 36vw; height: 36vw; right: -6vw; top: 6vw;   background: radial-gradient(circle, var(--nebula-c), transparent 70%); animation-delay: -8s; }\n  .wisp.c { width: 40vw; height: 40vw; left: 30vw;  bottom: -18vw; background: radial-gradient(circle, var(--nebula-b), transparent 70%); animation-delay: -15s; }\n  @keyframes drift {\n    0%,100% { transform: translate(0,0) scale(1); }\n    50%     { transform: translate(3vw,-3vw) scale(1.08); }\n  }\n\n  /* ---------- Layout ---------- */\n  .stage {\n    position: relative;\n    z-index: 2;\n    max-width: 860px;\n    margin: 0 auto;\n    padding: clamp(40px, 8vh, 90px) 22px 80px;\n  }\n\n  header { text-align: center; margin-bottom: 42px; animation: rise 0.9s cubic-bezier(.2,.8,.2,1) both; }\n  .eyebrow {\n    font-size: 12px; letter-spacing: 0.42em; text-transform: uppercase;\n    color: var(--accent); font-weight: 500; margin-bottom: 16px;\n    display: inline-flex; align-items: center; gap: 10px;\n  }\n  .eyebrow::before, .eyebrow::after {\n    content: \"\"; width: 34px; height: 1px;\n    background: linear-gradient(90deg, transparent, var(--accent));\n  }\n  .eyebrow::after { background: linear-gradient(90deg, var(--accent), transparent); }\n\n  h1 {\n    font-weight: 700;\n    font-size: clamp(38px, 7vw, 66px);\n    line-height: 1.02;\n    letter-spacing: -0.03em;\n    background: linear-gradient(180deg, #ffffff 0%, #b8bcff 70%, #7d82e0 100%);\n    -webkit-background-clip: text; background-clip: text;\n    -webkit-text-fill-color: transparent;\n    text-shadow: 0 0 60px rgba(139,141,255,0.25);\n  }\n  .sub { margin-top: 16px; color: var(--ink-soft); font-weight: 300; font-size: clamp(15px,2.2vw,17px); max-width: 520px; margin-inline: auto; }\n\n  /* ---------- Card ---------- */\n  .card {\n    background: var(--panel);\n    border: 1px solid var(--panel-brd);\n    border-radius: 22px;\n    padding: 30px;\n    backdrop-filter: blur(18px) saturate(140%);\n    -webkit-backdrop-filter: blur(18px) saturate(140%);\n    box-shadow:\n      0 30px 80px -30px rgba(0,0,0,0.8),\n      inset 0 1px 0 rgba(255,255,255,0.06);\n    animation: rise 0.9s cubic-bezier(.2,.8,.2,1) 0.12s both;\n  }\n\n  .field { margin-bottom: 24px; }\n  .field:last-child { margin-bottom: 0; }\n\n  label {\n    display: flex; align-items: center; gap: 8px;\n    font-size: 12.5px; font-weight: 500; letter-spacing: 0.14em;\n    text-transform: uppercase; color: var(--ink-soft); margin-bottom: 10px;\n  }\n  label .num {\n    display: grid; place-items: center;\n    width: 20px; height: 20px; border-radius: 50%;\n    font-size: 11px; font-family: 'JetBrains Mono', monospace;\n    color: var(--void); background: var(--accent); font-weight: 700;\n    letter-spacing: 0;\n  }\n  label .hint { margin-left: auto; text-transform: none; letter-spacing: 0; font-weight: 300; color: var(--ink-faint); font-size: 12px; }\n\n  input[type=text], textarea {\n    width: 100%;\n    background: rgba(4,5,15,0.6);\n    border: 1px solid rgba(140,150,255,0.16);\n    border-radius: 14px;\n    color: var(--ink);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13.5px;\n    line-height: 1.6;\n    padding: 14px 16px;\n    resize: vertical;\n    transition: border-color .2s, box-shadow .2s, background .2s;\n  }\n  input::placeholder, textarea::placeholder { color: var(--ink-faint); }\n  input:focus, textarea:focus {\n    outline: none;\n    border-color: var(--accent);\n    background: rgba(4,5,15,0.85);\n    box-shadow: 0 0 0 4px rgba(139,141,255,0.14);\n  }\n  textarea#emails { min-height: 128px; }\n\n  .row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 4px; }\n  .count { font-size: 12.5px; color: var(--ink-faint); font-family: 'JetBrains Mono', monospace; }\n  .count b { color: var(--accent-2); font-weight: 500; }\n\n  .toggle {\n    display: inline-flex; align-items: center; gap: 8px;\n    font-size: 12.5px; color: var(--ink-soft); cursor: pointer; user-select: none;\n  }\n  .toggle input { position: absolute; opacity: 0; pointer-events: none; }\n  .sw { width: 34px; height: 19px; border-radius: 20px; background: rgba(140,150,255,0.2); position: relative; transition: background .2s; flex: none; }\n  .sw::after { content:\"\"; position:absolute; top: 2px; left: 2px; width: 15px; height: 15px; border-radius: 50%; background: var(--ink); transition: transform .2s; }\n  .toggle input:checked + .sw { background: var(--accent); }\n  .toggle input:checked + .sw::after { transform: translateX(15px); }\n\n  /* ---------- Results ---------- */\n  .results { margin-top: 30px; animation: rise 0.7s ease both 0.2s; }\n  .results-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }\n  .results-head h2 {\n    font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft);\n    display: flex; align-items: center; gap: 9px;\n  }\n  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--good); box-shadow: 0 0 10px var(--good); }\n\n  .btn {\n    font-family: 'Sora', sans-serif; font-size: 13px; font-weight: 500;\n    border: 1px solid var(--panel-brd); background: rgba(139,141,255,0.1);\n    color: var(--ink); padding: 9px 15px; border-radius: 11px; cursor: pointer;\n    display: inline-flex; align-items: center; gap: 7px;\n    transition: background .18s, border-color .18s, transform .1s;\n  }\n  .btn:hover { background: rgba(139,141,255,0.22); border-color: var(--accent); }\n  .btn:active { transform: scale(0.97); }\n  .btn svg { width: 14px; height: 14px; }\n\n  .link-list { display: flex; flex-direction: column; gap: 10px; }\n  .link {\n    display: flex; align-items: center; gap: 14px;\n    background: rgba(4,5,15,0.5);\n    border: 1px solid rgba(140,150,255,0.1);\n    border-radius: 13px; padding: 13px 14px;\n    animation: rise .5s ease both;\n  }\n  .link:hover { border-color: rgba(140,150,255,0.28); }\n  .link .who { flex: none; width: 150px; overflow: hidden; }\n  .link .who .name { font-size: 13px; font-weight: 500; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .link .who .mail { font-size: 11px; color: var(--ink-faint); font-family:'JetBrains Mono',monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .link .url {\n    flex: 1; min-width: 0;\n    font-family:'JetBrains Mono',monospace; font-size: 12px; color: var(--accent-2);\n    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n  }\n  .icon-btn {\n    flex: none; width: 34px; height: 34px; border-radius: 9px;\n    border: 1px solid var(--panel-brd); background: rgba(139,141,255,0.08);\n    color: var(--ink-soft); cursor: pointer; display: grid; place-items: center;\n    transition: background .18s, color .18s, transform .1s;\n  }\n  .icon-btn:hover { background: rgba(139,141,255,0.2); color: var(--ink); }\n  .icon-btn:active { transform: scale(0.9); }\n  .icon-btn.copied { color: var(--good); border-color: rgba(79,255,196,0.4); background: rgba(79,255,196,0.1); }\n  .icon-btn svg { width: 15px; height: 15px; }\n\n  .empty {\n    text-align: center; color: var(--ink-faint); font-size: 13.5px; font-weight: 300;\n    padding: 34px 20px; border: 1px dashed rgba(140,150,255,0.16); border-radius: 14px;\n  }\n\n  .btn-primary {\n    margin-top: 22px; width: 100%;\n    font-family: 'Sora', sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.02em;\n    color: #08091a; cursor: pointer; border: none; border-radius: 13px; padding: 14px 18px;\n    display: inline-flex; align-items: center; justify-content: center; gap: 9px;\n    background: linear-gradient(135deg, var(--accent-2), var(--accent));\n    box-shadow: 0 10px 30px -8px rgba(82,229,255,0.5);\n    transition: transform .1s, box-shadow .2s, filter .2s;\n  }\n  .btn-primary:hover { filter: brightness(1.08); box-shadow: 0 14px 38px -8px rgba(82,229,255,0.65); }\n  .btn-primary:active { transform: scale(0.985); }\n  .btn-primary svg { width: 16px; height: 16px; }\n  .kbd-hint { margin-top: 11px; text-align: center; font-size: 11.5px; color: var(--ink-faint); font-weight: 300; }\n  .kbd-hint kbd {\n    font-family: 'JetBrains Mono', monospace; font-size: 10.5px;\n    background: rgba(140,150,255,0.12); border: 1px solid rgba(140,150,255,0.2);\n    border-radius: 5px; padding: 1px 6px; color: var(--ink-soft);\n  }\n\n  .actions { display: flex; gap: 8px; flex: none; }\n  .icon-btn.danger:hover { color: #ff8a9c; border-color: rgba(255,138,156,0.4); background: rgba(255,138,156,0.12); }\n  .time { font-size: 10.5px; color: var(--ink-faint); font-family: 'JetBrains Mono', monospace; margin-top: 4px; }\n\n  .section-gap { margin-top: 36px; }\n\n  footer { text-align: center; margin-top: 40px; font-size: 12px; color: var(--ink-faint); font-weight: 300; }\n  footer b { color: var(--ink-soft); font-weight: 400; }\n\n  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }\n\n  @media (max-width: 560px) {\n    .card { padding: 22px; }\n    .link { flex-wrap: wrap; }\n    .link .who { width: 100%; }\n    .link .url { width: 100%; flex-basis: 100%; }\n  }\n\n  /* toast */\n  #toast {\n    position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%) translateY(20px);\n    background: rgba(10,12,30,0.9); border: 1px solid var(--accent);\n    color: var(--ink); padding: 11px 20px; border-radius: 12px; font-size: 13px;\n    z-index: 20; opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s;\n    backdrop-filter: blur(10px);\n  }\n  #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n</style>\n</head>\n<body>\n  <div id=\"space\"></div>\n  <canvas id=\"stars\"></canvas>\n  <div class=\"wisp a\"></div>\n  <div class=\"wisp b\"></div>\n  <div class=\"wisp c\"></div>\n\n  <main class=\"stage\">\n    <header>\n      <div class=\"eyebrow\">Link Constellation</div>\n      <h1>URL Generator</h1>\n      <p class=\"sub\">Drop in a base link and a list of emails. Get a personalized, shareable URL for every recipient — instantly.</p>\n    </header>\n\n    <section class=\"card\">\n      <div class=\"field\">\n        <label for=\"base\"><span class=\"num\">1</span> Base URL template</label>\n        <input id=\"base\" type=\"text\" spellcheck=\"false\"\n          value=\"https://hc4ll5gtr2e.typeform.com/to/vt4Atzbj#first_name=xxxxx&email=xxxxx\" />\n      </div>\n\n      <div class=\"field\">\n        <label for=\"emails\"><span class=\"num\">2</span> Recipients <span class=\"hint\">one per line — \"Name email@x.com\" or just an email</span></label>\n        <textarea id=\"emails\" spellcheck=\"false\" placeholder=\"Ada ada@example.com&#10;Grace, grace.hopper@example.com&#10;alan@example.com\"></textarea>\n        <div class=\"row\">\n          <span class=\"count\"><b id=\"cnt\">0</b> recipients detected</span>\n          <label class=\"toggle\" title=\"When a line has no name, derive first_name from the email\">\n            <input type=\"checkbox\" id=\"autoName\" checked />\n            <span class=\"sw\"></span> Auto-fill first name when only an email is given\n          </label>\n        </div>\n      </div>\n\n      <button class=\"btn-primary\" id=\"genBtn\" type=\"button\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 2 3 14h7l-1 8 10-12h-7l1-8z\"/></svg>\n        Generate links\n      </button>\n      <div class=\"kbd-hint\">Press <kbd>Enter</kbd> to generate · <kbd>Shift</kbd>+<kbd>Enter</kbd> for a new line</div>\n    </section>\n\n    <section class=\"results\">\n      <div class=\"results-head\">\n        <h2><span class=\"dot\"></span> Generated Links</h2>\n        <button class=\"btn\" id=\"copyAll\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg>\n          Copy all\n        </button>\n      </div>\n      <div id=\"out\" class=\"link-list\"></div>\n    </section>\n\n    <section class=\"results section-gap\">\n      <div class=\"results-head\">\n        <h2><span class=\"dot\" style=\"background:var(--accent);box-shadow:0 0 10px var(--accent)\"></span> History <span id=\"histCount\" class=\"count\" style=\"text-transform:none;letter-spacing:0\"></span></h2>\n        <button class=\"btn\" id=\"clearHist\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6\"/><path d=\"M10 11v6M14 11v6\"/></svg>\n          Clear all\n        </button>\n      </div>\n      <div id=\"hist\" class=\"link-list\"></div>\n    </section>\n\n    <footer>Runs entirely in your browser — nothing is uploaded, history is saved on this device. Built for <b>ClickPost</b>.</footer>\n  </main>\n\n  <div id=\"toast\"></div>\n\n<script>\n(function () {\n  \"use strict\";\n\n  const $ = (s) => document.querySelector(s);\n  const baseEl = $(\"#base\");\n  const emailsEl = $(\"#emails\");\n  const autoNameEl = $(\"#autoName\");\n  const out = $(\"#out\");\n  const cntEl = $(\"#cnt\");\n  const toast = $(\"#toast\");\n  const hist = $(\"#hist\");\n  const histCount = $(\"#histCount\");\n\n  const EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  // One recipient per line. A line may hold a name + email in either order\n  // (\"Shyam sayhelloshyam@gmail.com\", \"Shyam, shyam@x.com\", \"shyam@x.com\"),\n  // or several bare emails separated by commas/spaces.\n  function parseRecipients(text) {\n    const seen = new Set();\n    const out = [];\n    text.split(/\\r?\\n/).forEach((line) => {\n      const raw = line.trim();\n      if (!raw) return;\n      const tokens = raw.split(/[\\s,;]+/).filter(Boolean);\n      const emails = tokens.filter((t) => EMAIL_RE.test(t));\n      const rest = tokens.filter((t) => !EMAIL_RE.test(t));\n      if (!emails.length) return;\n      if (emails.length === 1) {\n        pushRec(out, seen, rest.join(\" \").trim(), emails[0]);\n      } else {\n        // multiple emails on one line -> each is its own recipient, name derived\n        emails.forEach((e) => pushRec(out, seen, \"\", e));\n      }\n    });\n    return out;\n  }\n  function pushRec(out, seen, name, email) {\n    const k = email.toLowerCase();\n    if (seen.has(k)) return;\n    seen.add(k);\n    out.push({ name, email });\n  }\n\n  // \"shyam.j@clickpost.ai\" -> \"Shyam\"\n  function firstNameFromEmail(email) {\n    let local = email.split(\"@\")[0];\n    let token = local.split(/[._+\\-]/)[0] || local;\n    token = token.replace(/[^a-zA-Z]/g, \"\");\n    if (!token) return \"\";\n    return token.charAt(0).toUpperCase() + token.slice(1).toLowerCase();\n  }\n\n  // Replace `key=<value>` (query or fragment) with the value verbatim.\n  // Only the matching placeholder is swapped — nothing else in the URL changes.\n  function setParam(url, key, value) {\n    const re = new RegExp(\"([?#&])(\" + key + \")=[^&]*\", \"i\");\n    if (re.test(url)) {\n      return url.replace(re, (m, sep, k) => sep + k + \"=\" + value);\n    }\n    return url;\n  }\n\n  // Explicit name wins (first word only, since the field is first_name);\n  // otherwise derive from the email if auto-fill is on.\n  function resolveName(rec) {\n    if (rec.name) return rec.name.split(/\\s+/)[0];\n    if (autoNameEl.checked) return firstNameFromEmail(rec.email);\n    return \"\";\n  }\n\n  function buildUrl(base, rec) {\n    // Email goes in verbatim (no encoding). Only a space in a name is escaped,\n    // since a raw space would break the link.\n    let url = setParam(base, \"email\", rec.email);\n    const name = resolveName(rec);\n    if (name) url = setParam(url, \"first_name\", name.replace(/\\s+/g, \"%20\"));\n    return url;\n  }\n\n  const ICON_COPY = '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg>';\n  const ICON_CHECK = '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M20 6L9 17l-5-5\"/></svg>';\n  const ICON_X = '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg>';\n\n  let currentLinks = [];\n\n  // Build one link row. opts.time -> show a timestamp; opts.onRemove -> show a remove button.\n  function makeRow(item, opts) {\n    opts = opts || {};\n    const row = document.createElement(\"div\");\n    row.className = \"link\";\n\n    const who = document.createElement(\"div\");\n    who.className = \"who\";\n    const nameEl = document.createElement(\"div\");\n    nameEl.className = \"name\";\n    nameEl.textContent = item.name || \"—\";\n    const mailEl = document.createElement(\"div\");\n    mailEl.className = \"mail\";\n    mailEl.textContent = item.email;\n    who.append(nameEl, mailEl);\n    if (opts.time) {\n      const t = document.createElement(\"div\");\n      t.className = \"time\";\n      t.textContent = opts.time;\n      who.appendChild(t);\n    }\n\n    const url = document.createElement(\"div\");\n    url.className = \"url\";\n    url.textContent = item.url;\n    url.title = item.url;\n\n    const actions = document.createElement(\"div\");\n    actions.className = \"actions\";\n\n    const copyBtn = document.createElement(\"button\");\n    copyBtn.className = \"icon-btn\";\n    copyBtn.type = \"button\";\n    copyBtn.title = \"Copy link\";\n    copyBtn.innerHTML = ICON_COPY;\n    copyBtn.addEventListener(\"click\", () => {\n      copy(item.url);\n      copyBtn.innerHTML = ICON_CHECK;\n      copyBtn.classList.add(\"copied\");\n      setTimeout(() => { copyBtn.innerHTML = ICON_COPY; copyBtn.classList.remove(\"copied\"); }, 1400);\n    });\n    actions.appendChild(copyBtn);\n\n    if (opts.onRemove) {\n      const rm = document.createElement(\"button\");\n      rm.className = \"icon-btn danger\";\n      rm.type = \"button\";\n      rm.title = \"Remove from history\";\n      rm.innerHTML = ICON_X;\n      rm.addEventListener(\"click\", opts.onRemove);\n      actions.appendChild(rm);\n    }\n\n    row.append(who, url, actions);\n    return row;\n  }\n\n  function updateCount() {\n    cntEl.textContent = parseRecipients(emailsEl.value).length;\n  }\n\n  // Build links from the current input — runs only when the user hits Enter / Generate.\n  function generate() {\n    const base = baseEl.value.trim();\n    const recs = parseRecipients(emailsEl.value);\n    updateCount();\n\n    if (!recs.length) {\n      currentLinks = [];\n      renderLatest();\n      showToast(\"Enter at least one email address\");\n      return;\n    }\n\n    currentLinks = recs.map((r) => ({ email: r.email, name: resolveName(r), url: buildUrl(base, r) }));\n    renderLatest();\n    addToHistory(currentLinks);\n    renderHistory();\n    showToast(\"Generated \" + currentLinks.length + \" link\" + (currentLinks.length > 1 ? \"s\" : \"\"));\n  }\n\n  function renderLatest() {\n    if (!currentLinks.length) {\n      out.innerHTML = '<div class=\"empty\">Your personalized links will appear here after you hit Enter.</div>';\n      return;\n    }\n    out.innerHTML = \"\";\n    currentLinks.forEach((item, i) => {\n      const row = makeRow(item);\n      row.style.animationDelay = Math.min(i * 0.04, 0.4) + \"s\";\n      out.appendChild(row);\n    });\n  }\n\n  /* ---------- History (persisted in localStorage) ---------- */\n  const HKEY = \"urlgen.history.v1\";\n  let histItems = loadHistory();\n\n  function loadHistory() {\n    try { return JSON.parse(localStorage.getItem(HKEY)) || []; } catch (e) { return []; }\n  }\n  function saveHistory() {\n    try { localStorage.setItem(HKEY, JSON.stringify(histItems)); } catch (e) {}\n  }\n  function addToHistory(links) {\n    const now = Date.now();\n    links.forEach((l) => {\n      const i = histItems.findIndex((h) => h.url === l.url);\n      if (i !== -1) histItems.splice(i, 1);       // de-dup: bump to the top\n      histItems.unshift({ name: l.name, email: l.email, url: l.url, ts: now });\n    });\n    if (histItems.length > 500) histItems.length = 500;\n    saveHistory();\n  }\n  function fmtTime(ts) {\n    try {\n      return new Date(ts).toLocaleString(undefined, { month: \"short\", day: \"numeric\", hour: \"2-digit\", minute: \"2-digit\" });\n    } catch (e) { return \"\"; }\n  }\n  function renderHistory() {\n    histCount.textContent = histItems.length ? \"(\" + histItems.length + \")\" : \"\";\n    if (!histItems.length) {\n      hist.innerHTML = '<div class=\"empty\">Nothing yet — links you generate are saved here, even after you close the page.</div>';\n      return;\n    }\n    hist.innerHTML = \"\";\n    histItems.forEach((item, i) => {\n      const row = makeRow(item, {\n        time: fmtTime(item.ts),\n        onRemove: () => {\n          const idx = histItems.findIndex((h) => h.url === item.url && h.ts === item.ts);\n          if (idx !== -1) histItems.splice(idx, 1);\n          saveHistory();\n          renderHistory();\n        }\n      });\n      if (i < 12) row.style.animationDelay = Math.min(i * 0.03, 0.35) + \"s\";\n      hist.appendChild(row);\n    });\n  }\n\n  function copy(text) {\n    if (navigator.clipboard && window.isSecureContext) {\n      navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));\n    } else {\n      fallbackCopy(text);\n    }\n  }\n  function fallbackCopy(text) {\n    const ta = document.createElement(\"textarea\");\n    ta.value = text; ta.style.position = \"fixed\"; ta.style.opacity = \"0\";\n    document.body.appendChild(ta); ta.select();\n    try { document.execCommand(\"copy\"); } catch (e) {}\n    document.body.removeChild(ta);\n  }\n\n  let toastTimer;\n  function showToast(msg) {\n    toast.textContent = msg;\n    toast.classList.add(\"show\");\n    clearTimeout(toastTimer);\n    toastTimer = setTimeout(() => toast.classList.remove(\"show\"), 1900);\n  }\n\n  $(\"#copyAll\").addEventListener(\"click\", () => {\n    if (!currentLinks.length) { showToast(\"Generate some links first\"); return; }\n    copy(currentLinks.map((l) => l.url).join(\"\\n\"));\n    showToast(\"Copied \" + currentLinks.length + \" link\" + (currentLinks.length > 1 ? \"s\" : \"\") + \" to clipboard\");\n  });\n\n  $(\"#genBtn\").addEventListener(\"click\", generate);\n\n  $(\"#clearHist\").addEventListener(\"click\", () => {\n    if (!histItems.length) return;\n    histItems = [];\n    saveHistory();\n    renderHistory();\n    showToast(\"History cleared\");\n  });\n\n  // Enter generates; Shift+Enter inserts a newline for multiple recipients.\n  emailsEl.addEventListener(\"keydown\", (e) => {\n    if (e.key === \"Enter\" && !e.shiftKey) { e.preventDefault(); generate(); }\n  });\n  baseEl.addEventListener(\"keydown\", (e) => {\n    if (e.key === \"Enter\") { e.preventDefault(); generate(); }\n  });\n\n  [baseEl, emailsEl].forEach((el) => el.addEventListener(\"input\", updateCount));\n  autoNameEl.addEventListener(\"change\", updateCount);\n\n  updateCount();\n  renderLatest();\n  renderHistory();\n\n  /* ---------- Starfield ---------- */\n  const canvas = $(\"#stars\");\n  const ctx = canvas.getContext(\"2d\");\n  let stars = [], w, h, dpr;\n\n  function seed() {\n    dpr = Math.min(window.devicePixelRatio || 1, 2);\n    w = canvas.width = innerWidth * dpr;\n    h = canvas.height = innerHeight * dpr;\n    canvas.style.width = innerWidth + \"px\";\n    canvas.style.height = innerHeight + \"px\";\n    const count = Math.round((innerWidth * innerHeight) / 5200);\n    stars = Array.from({ length: count }, () => ({\n      x: Math.random() * w,\n      y: Math.random() * h,\n      r: (Math.random() * 1.3 + 0.2) * dpr,\n      base: Math.random() * 0.5 + 0.3,\n      tw: Math.random() * 0.02 + 0.004,\n      ph: Math.random() * Math.PI * 2,\n      hue: Math.random() < 0.15 ? 190 : (Math.random() < 0.5 ? 240 : 40)\n    }));\n  }\n\n  let t = 0;\n  function draw() {\n    ctx.clearRect(0, 0, w, h);\n    t += 1;\n    for (const s of stars) {\n      const a = s.base + Math.sin(t * s.tw + s.ph) * 0.35;\n      ctx.beginPath();\n      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);\n      ctx.fillStyle = \"hsla(\" + s.hue + \",90%,88%,\" + Math.max(0, a) + \")\";\n      ctx.shadowBlur = 6 * dpr;\n      ctx.shadowColor = \"hsla(\" + s.hue + \",90%,80%,0.6)\";\n      ctx.fill();\n    }\n    ctx.shadowBlur = 0;\n    requestAnimationFrame(draw);\n  }\n\n  seed();\n  draw();\n  let rz;\n  addEventListener(\"resize\", () => { clearTimeout(rz); rz = setTimeout(seed, 200); });\n})();\n</script>\n</body>\n</html>\n"